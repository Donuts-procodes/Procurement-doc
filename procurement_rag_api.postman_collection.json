      "value": "session_sample_101",
      "type": "string"
    },
    {
      "key": "kbId",
      "value": "kb_default",
      "type": "string"
    },
    {
      "key": "documentId",
      "value": "doc_sample_101",
      "type": "string"
    },
    {
      "key": "segmentId",
      "value": "seg_sample_1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Check if backend server is online and operational."
          }
        }
      ]
    },
    {
      "name": "Session & Providers",
      "item": [
        {
          "name": "List Supported Providers & Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/session/providers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "session",
                "providers"
              ]
            },
            "description": "Retrieve supported LLM providers (openai, gemini, anthropic) and available models."
          }
        },
        {
          "name": "Create AI Session",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.session_id) {",
                  "        pm.collectionVariables.set('sessionId', data.session_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"openai\",\n  \"model\": \"gpt-4o\",\n  \"api_key\": \"{{apiKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/session",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "session"
              ]
            },
            "description": "Initialize an in-memory session config for LLM orchestrations."
          }
        }
      ]
    },
    {
