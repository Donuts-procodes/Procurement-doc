    {
      "name": "Document Generation & Refinement",
      "item": [
        {
          "name": "Initial Generate Document",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    if (data.document_id) {",
                  "        pm.collectionVariables.set('documentId', data.document_id);",
                  "    }",
                  "    if (data.segments && data.segments.length > 0) {",
                  "        pm.collectionVariables.set('segmentId', data.segments[0].segment_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"kb_id\": \"{{kbId}}\",\n  \"procurement_doc_type\": \"RFP\",\n  \"template_id\": \"rfp_enterprise\",\n  \"num_pages\": 5,\n  \"page_layout_size\": \"A4\",\n  \"prompt\": \"Draft a cloud migration RFP for a healthcare portal with strict HIPAA compliance\",\n  \"content_density\": \"med\",\n  \"provider\": \"openai\",\n  \"model\": \"gpt-4o\",\n  \"api_key\": \"{{apiKey}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/generate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "generate"
              ]
            },
            "description": "Trigger multi-agent pipeline (Planner, Retrieval, Line-Item Math, Parallel Writers, Verifier)."
          }
        },
        {
          "name": "Answer Clarifying Question",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"document_id\": \"{{documentId}}\",\n  \"answer\": \"Target completion within 9 months, budget cap is $1.2M USD.\",\n  \"content_density\": \"med\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/generate/answer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "generate",
                "answer"
              ]
            },
            "description": "Submit an answer to an agent clarifying question to continue generation."
          }
        },
        {
          "name": "Refine Document Segment (Page / Section)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"document_id\": \"{{documentId}}\",\n  \"segment_id\": \"{{segmentId}}\",\n  \"instruction\": \"Expand the evaluation criteria into a detailed 4-column rubric table with score weights.\",\n  \"content_density\": \"med\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/generate/refine-segment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "generate",
                "refine-segment"
              ]
            },
            "description": "Refine, expand, or rewrite a specific document segment/page via LangGraph edit graph."
          }
        },
        {
          "name": "Refine Selected Text Snippet",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_id\": \"{{sessionId}}\",\n  \"selection_text\": \"The vendor must provide standard SLA terms.\",\n  \"instruction\": \"Make this specific to 99.99% uptime with 15-minute response for P1 incidents.\",\n  \"content_density\": \"med\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/generate/refine-selection",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "generate",
                "refine-selection"
              ]
            },
            "description": "Surgically rewrite a highlighted sentence or paragraph in the document editor."
          }
        }
      ]
    },
    {
      "name": "Document Audit & Workflow",
      "item": [
        {
          "name": "Update Document Status",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/document/{{documentId}}/status?status=UNDER_REVIEW&actor=Lead_Procurement_Officer",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "document",
                "{{documentId}}",
                "status"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "UNDER_REVIEW"
                },
                {
                  "key": "actor",
                  "value": "Lead_Procurement_Officer"
                }
              ]
            },
            "description": "Update workflow status of a document (e.g. DRAFT -> UNDER_REVIEW -> APPROVED)."
